<Window x:Class="HIDra.UI.Views.VirtualKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HIDra Virtual Keyboard"
        Width="1490" Height="356"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#666666"
        BorderThickness="1"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#2C2C2C"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False">

    <!--
        No title bar, and drawn as a see-through window, so that it can fade to let the
        text behind it show through. Windows ignores fading for a window that has the
        standard title bar. Nothing is lost: the controller button that opens it closes it, it is
        positioned by HIDra (LT, or the main screen), and a title bar could not be used
        from the controller anyway.
    -->

    <!--
        Two kinds of key, and the difference between them is meant to be visible at a
        glance rather than only in the markup:

          typing keys    dark, large glyph - the letters, digits and symbols
          function keys  lighter, smaller word - everything that acts rather than types

        The four backgrounds this file used to carry (#3C3C3C, #424242, #383838,
        #4A4A4A) differed by two to six values per channel, which is invisible on
        screen. They separated the keys in the source and nowhere else, so the only
        thing the user could actually see was the font size - and that ran 11, 12, 13,
        14, 16, 18 and 20 with no rule behind it, which reads as accidental.
    -->
    <Window.Resources>
        <!-- Base Key Button Style with Animation -->
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Flashing green and back used to be two animations, the
                                                 second of which returned every key to #3C3C3C and held
                                                 it there. That was invisible while all the keys were
                                                 nearly that colour anyway; now that a function key is
                                                 visibly lighter, one press would have repainted it as a
                                                 letter key for good. Reversing a single animation and
                                                 stopping it hands the key back to whatever colour its
                                                 own style says it is. -->
                                            <ColorAnimation Storyboard.TargetName="border"
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#B85400"
                                                          Duration="0:0:0.1"
                                                          AutoReverse="True"
                                                          FillBehavior="Stop"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Only the border reacts to the mouse. Recolouring the background would
                     wipe out the difference between a typing key and a function key, and
                     fight the orange that Shift, Ctrl, Caps and Select use to show they are
                     on. Pale grey, not orange: an orange border is the stick's highlight,
                     and two of them would leave it unclear which key A will type. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#BBBBBB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Letters: the most frequent keys, so the largest glyph on the board -->
        <Style x:Key="LetterKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <!-- Digits and symbols: two glyphs stacked, sized by the runs inside them -->
        <Style x:Key="PairedKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}"/>
        <!-- Emoji keys. Windows' own emoji panel takes the controller away from HIDra, so
             the everyday emoji are keys here instead. -->
        <Style x:Key="EmojiKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}"/>

        <!-- Function keys: they act rather than type, and say so by being lighter -->
        <Style x:Key="FunctionKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="Background" Value="#565656"/>
            <Setter Property="BorderBrush" Value="#767676"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Function keys labelled with a symbol rather than a word -->
        <Style x:Key="FunctionGlyphKeyStyle" TargetType="Button" BasedOn="{StaticResource FunctionKeyStyle}">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <!-- Word suggestions: a distinct green so they read as offers, not as keys that
             type a single character. Normal weight keeps longer words from crowding. -->
        <!-- Shortcuts: one row per kind of action, each row its own muted colour with a
             word beside it, so the panel reads as five groups rather than twenty-five
             keys. The colours are dark and quiet on purpose: orange is kept for the
             highlight and for "on", and must stay the loudest thing on the board. -->
        <Style x:Key="ShortcutKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="Background" Value="#2E3A48"/>
            <Setter Property="BorderBrush" Value="#5C7A99"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- Edit: Undo, Redo, Cut, Copy, Paste - blue-grey -->
        <Style x:Key="ShortcutEditStyle" TargetType="Button" BasedOn="{StaticResource ShortcutKeyStyle}"/>
        <!-- Select: the Select switch, Select all, moving and deleting by word - teal -->
        <Style x:Key="ShortcutSelectStyle" TargetType="Button" BasedOn="{StaticResource ShortcutKeyStyle}">
            <Setter Property="Background" Value="#223B3A"/>
            <Setter Property="BorderBrush" Value="#4F8C87"/>
        </Style>
        <!-- Style: Bold, Italic, Underline, bigger and smaller text - violet -->
        <Style x:Key="ShortcutStyleStyle" TargetType="Button" BasedOn="{StaticResource ShortcutKeyStyle}">
            <Setter Property="Background" Value="#342D45"/>
            <Setter Property="BorderBrush" Value="#7D6BA3"/>
        </Style>
        <!-- Tools: Windows' own helpers - voice typing, emoji, Save, Files, Snip - rose -->
        <Style x:Key="ShortcutToolsStyle" TargetType="Button" BasedOn="{StaticResource ShortcutKeyStyle}">
            <Setter Property="Background" Value="#422B34"/>
            <Setter Property="BorderBrush" Value="#9C5F73"/>
        </Style>
        <!-- The row that follows the program in front - neutral, with the program named -->
        <Style x:Key="ShortcutProgramStyle" TargetType="Button" BasedOn="{StaticResource ShortcutKeyStyle}">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="#8A8A8A"/>
        </Style>

        <Style x:Key="ShortcutRowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="SuggestionKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="Background" Value="#23402A"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="KeyboardRoot" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- The keys, then the shortcut panel beside Backspace, Del and Enter -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition x:Name="ShortcutColumn" Width="5.8*"/>
        </Grid.ColumnDefinitions>

        <!-- Word suggestions from Windows' built-in prediction. Always on screen, even
             when empty, so the rows below never shift and the highlight's routes stay
             where the user has learned them. Pushing up from the number row reaches
             them; A types the rest of the word and a space, B the same capitalised. -->
        <Grid x:Name="TopRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Swap the row between suggestions and the student's own phrases, or the
                 programs she can open in one press -->
            <Button x:Name="PhrasesKey" Grid.Column="0" Style="{StaticResource FunctionKeyStyle}" Content="Phrases" Click="PhrasesKey_Click"/>
            <Button x:Name="AppsKey" Grid.Column="1" Style="{StaticResource FunctionKeyStyle}" Content="Apps" Click="AppsKey_Click"/>
            <Button x:Name="Suggestion0" Grid.Column="2" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="0"/>
            <Button x:Name="Suggestion1" Grid.Column="3" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="1"/>
            <Button x:Name="Suggestion2" Grid.Column="4" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="2"/>
            <Button x:Name="Suggestion3" Grid.Column="5" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="3"/>
            <Button x:Name="Suggestion4" Grid.Column="6" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="4"/>
            <Button x:Name="Suggestion5" Grid.Column="7" Style="{StaticResource SuggestionKeyStyle}" Click="SuggestionButton_Click" Tag="5"/>
        </Grid>

        <!--
            The letters in a straight grid, in QWERTY order: the same shape for all three
            letter rows - one key each side, ten between - so the columns line up and
            pushing up or down always goes straight to the key above or below. A staggered
            layout, like a real keyboard's, helps fingers but not a highlight moved by a
            stick: down from a key landed between two, and which one had to be learned.

            There used to be a number row and fourteen equal keys to every row, so the
            symbols typed least - [ ] \ ; # = - cost a full key each, on the way to the
            ones typed most. Now the letters share their places with a second layer, the
            way a phone does: the 123 key swaps the letters for digits and symbols, in the
            same cells, and abc swaps them back. Everything around the edge - Tab,
            Backspace, Esc, Enter, Shift, Del, Space, the arrows - stays exactly where it is on
            both, so switching never moves a key the student is heading for.

            The keys typed most are the biggest: Space by far, then Enter and Backspace.
            With no number row the word suggestions are one step nearer the letters. The
            punctuation on the letters layer is what sentences need - ' , . / - with
            @ ? and the rest on B, as before.
        -->

        <!-- Row 1: Tab, q to p (or 1 to 0), Backspace. There is no close key - the button
             that opens the keyboard closes it, and a key that ends typing was one overshoot
             away from doing so by mistake. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource FunctionKeyStyle}" Content="Tab" Click="TabButton_Click"/>
            <UniformGrid x:Name="LettersRow1" Grid.Column="1" Rows="1" Columns="10">
                <Button x:Name="KeyQ" Style="{StaticResource LetterKeyStyle}" Content="q" Click="KeyButton_Click" Tag="Q"/>
                <Button x:Name="KeyW" Style="{StaticResource LetterKeyStyle}" Content="w" Click="KeyButton_Click" Tag="W"/>
                <Button x:Name="KeyE" Style="{StaticResource LetterKeyStyle}" Content="e" Click="KeyButton_Click" Tag="E"/>
                <Button x:Name="KeyR" Style="{StaticResource LetterKeyStyle}" Content="r" Click="KeyButton_Click" Tag="R"/>
                <Button x:Name="KeyT" Style="{StaticResource LetterKeyStyle}" Content="t" Click="KeyButton_Click" Tag="T"/>
                <Button x:Name="KeyY" Style="{StaticResource LetterKeyStyle}" Content="y" Click="KeyButton_Click" Tag="Y"/>
                <Button x:Name="KeyU" Style="{StaticResource LetterKeyStyle}" Content="u" Click="KeyButton_Click" Tag="U"/>
                <Button x:Name="KeyI" Style="{StaticResource LetterKeyStyle}" Content="i" Click="KeyButton_Click" Tag="I"/>
                <Button x:Name="KeyO" Style="{StaticResource LetterKeyStyle}" Content="o" Click="KeyButton_Click" Tag="O"/>
                <Button x:Name="KeyP" Style="{StaticResource LetterKeyStyle}" Content="p" Click="KeyButton_Click" Tag="P"/>
            </UniformGrid>
            <UniformGrid x:Name="SymbolsRow1" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button x:Name="Key1" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="1">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">!</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">1</Run></TextBlock>
                </Button>
                <Button x:Name="Key2" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="2">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">"</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">2</Run></TextBlock>
                </Button>
                <Button x:Name="Key3" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="3">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">£</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">3</Run></TextBlock>
                </Button>
                <Button x:Name="Key4" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="4">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">$</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">4</Run></TextBlock>
                </Button>
                <Button x:Name="Key5" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="5">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">%</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">5</Run></TextBlock>
                </Button>
                <Button x:Name="Key6" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="6">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">^</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">6</Run></TextBlock>
                </Button>
                <Button x:Name="Key7" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="7">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">&amp;</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">7</Run></TextBlock>
                </Button>
                <Button x:Name="Key8" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="8">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">*</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">8</Run></TextBlock>
                </Button>
                <Button x:Name="Key9" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="9">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">(</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">9</Run></TextBlock>
                </Button>
                <Button x:Name="Key0" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="0">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">)</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">0</Run></TextBlock>
                </Button>
            </UniformGrid>
            <!-- Emoji, reached from the Emoji key on the 123 #+ layer, or an Emoji button job.
                 Colour pictures from Microsoft's Fluent Emoji (MIT licence, Emoji/LICENSE.txt):
                 WPF can only draw emoji characters in one colour. -->
            <UniformGrid x:Name="EmojiRow1" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F602;" ToolTip="Face with tears of joy"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f602.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x2764;&#xFE0F;" ToolTip="Red heart"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/2764.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F923;" ToolTip="Rolling on the floor laughing"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f923.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F44D;" ToolTip="Thumbs up"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f44d.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F62D;" ToolTip="Loudly crying face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f62d.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F64F;" ToolTip="Folded hands"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f64f.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F618;" ToolTip="Face blowing a kiss"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f618.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F970;" ToolTip="Smiling face with hearts"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f970.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F60D;" ToolTip="Smiling face with heart-eyes"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f60d.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F60A;" ToolTip="Smiling face with smiling eyes"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f60a.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
            </UniformGrid>
            <!-- LB, RB and Y type these from anywhere on the board, and say so on the key, so
                 the shortcut is learned by seeing it -->
            <Button Grid.Column="2" Style="{StaticResource FunctionGlyphKeyStyle}" Click="BackspaceButton_Click">
                <StackPanel>
                    <TextBlock Text="⌫" HorizontalAlignment="Center"/>
                    <TextBlock Text="LB" FontSize="12" FontWeight="SemiBold" Foreground="#FFC27A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 2: a to l, or the symbols typed least -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!-- Landing on Esc by mistake sends one Escape, the cheapest mistake there is,
                 so it can sit at an edge -->
            <Button Grid.Column="0" Style="{StaticResource FunctionKeyStyle}" Content="Esc" Click="EscapeButton_Click"/>
            <UniformGrid x:Name="LettersRow2" Grid.Column="1" Rows="1" Columns="10">
                <Button x:Name="KeyA" Style="{StaticResource LetterKeyStyle}" Content="a" Click="KeyButton_Click" Tag="A"/>
                <Button x:Name="KeyS" Style="{StaticResource LetterKeyStyle}" Content="s" Click="KeyButton_Click" Tag="S"/>
                <Button x:Name="KeyD" Style="{StaticResource LetterKeyStyle}" Content="d" Click="KeyButton_Click" Tag="D"/>
                <Button x:Name="KeyF" Style="{StaticResource LetterKeyStyle}" Content="f" Click="KeyButton_Click" Tag="F"/>
                <Button x:Name="KeyG" Style="{StaticResource LetterKeyStyle}" Content="g" Click="KeyButton_Click" Tag="G"/>
                <Button x:Name="KeyH" Style="{StaticResource LetterKeyStyle}" Content="h" Click="KeyButton_Click" Tag="H"/>
                <Button x:Name="KeyJ" Style="{StaticResource LetterKeyStyle}" Content="j" Click="KeyButton_Click" Tag="J"/>
                <Button x:Name="KeyK" Style="{StaticResource LetterKeyStyle}" Content="k" Click="KeyButton_Click" Tag="K"/>
                <Button x:Name="KeyL" Style="{StaticResource LetterKeyStyle}" Content="l" Click="KeyButton_Click" Tag="L"/>
                <Button x:Name="KeyQuote" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="'">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">@</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">'</Run></TextBlock>
                </Button>
            </UniformGrid>
            <UniformGrid x:Name="SymbolsRow2" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button x:Name="KeyMinus" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="-">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">_</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">-</Run></TextBlock>
                </Button>
                <Button x:Name="KeyEquals" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="=">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">+</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">=</Run></TextBlock>
                </Button>
                <Button x:Name="KeyBracketOpen" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="[">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">{</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">[</Run></TextBlock>
                </Button>
                <Button x:Name="KeyBracketClose" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="]">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">}</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">]</Run></TextBlock>
                </Button>
                <Button x:Name="KeySemicolon" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag=";">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">:</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">;</Run></TextBlock>
                </Button>
                <Button x:Name="KeyHash" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="#">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">~</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">#</Run></TextBlock>
                </Button>
                <Button x:Name="KeyBackslash" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="\">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">|</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">\</Run></TextBlock>
                </Button>
                <Button Style="{StaticResource LetterKeyStyle}" Content="€" Click="KeyButton_Click" Tag="€"/>
                <!-- Caps Lock is rarely wanted with capitals automatic and B for a single
                     capital, so it waits here rather than taking a place by the letters -->
                <Button x:Name="CapsLockKey" Style="{StaticResource FunctionKeyStyle}" Content="Caps" Click="CapsLockButton_Click"/>
                <Button Style="{StaticResource FunctionKeyStyle}" Content="Win" Click="WindowsKeyButton_Click"/>
            </UniformGrid>
            <UniformGrid x:Name="EmojiRow2" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F389;" ToolTip="Party popper"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f389.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F601;" ToolTip="Beaming face with smiling eyes"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f601.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F495;" ToolTip="Two hearts"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f495.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F97A;" ToolTip="Pleading face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f97a.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F605;" ToolTip="Grinning face with sweat"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f605.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F525;" ToolTip="Fire"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f525.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F926;" ToolTip="Person facepalming"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f926.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F937;" ToolTip="Person shrugging"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f937.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F644;" ToolTip="Face with rolling eyes"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f644.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F606;" ToolTip="Grinning squinting face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f606.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
            </UniformGrid>
            <Button Grid.Column="2" Style="{StaticResource FunctionGlyphKeyStyle}" Click="EnterButton_Click">
                <StackPanel>
                    <TextBlock Text="↵" HorizontalAlignment="Center"/>
                    <TextBlock Text="Y" FontSize="12" FontWeight="SemiBold" Foreground="#FFC27A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 3: z to m and sentence punctuation, or the shifted symbols used most -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ShiftKey" Style="{StaticResource FunctionGlyphKeyStyle}" Content="⇧" Click="ShiftButton_Click"/>
            <UniformGrid x:Name="LettersRow3" Grid.Column="1" Rows="1" Columns="10">
                <Button x:Name="KeyZ" Style="{StaticResource LetterKeyStyle}" Content="z" Click="KeyButton_Click" Tag="Z"/>
                <Button x:Name="KeyX" Style="{StaticResource LetterKeyStyle}" Content="x" Click="KeyButton_Click" Tag="X"/>
                <Button x:Name="KeyC" Style="{StaticResource LetterKeyStyle}" Content="c" Click="KeyButton_Click" Tag="C"/>
                <Button x:Name="KeyV" Style="{StaticResource LetterKeyStyle}" Content="v" Click="KeyButton_Click" Tag="V"/>
                <Button x:Name="KeyB" Style="{StaticResource LetterKeyStyle}" Content="b" Click="KeyButton_Click" Tag="B"/>
                <Button x:Name="KeyN" Style="{StaticResource LetterKeyStyle}" Content="n" Click="KeyButton_Click" Tag="N"/>
                <Button x:Name="KeyM" Style="{StaticResource LetterKeyStyle}" Content="m" Click="KeyButton_Click" Tag="M"/>
                <Button x:Name="KeyComma" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag=",">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">&lt;</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">,</Run></TextBlock>
                </Button>
                <Button x:Name="KeyPeriod" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag=".">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">&gt;</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">.</Run></TextBlock>
                </Button>
                <Button x:Name="KeySlash" Style="{StaticResource PairedKeyStyle}" Click="KeyButton_Click" Tag="/">
                    <TextBlock TextAlignment="Center"><Run FontSize="13" Foreground="#CCCCCC">?</Run><LineBreak/><Run FontSize="18" FontWeight="Bold">/</Run></TextBlock>
                </Button>
            </UniformGrid>
            <!-- These are on B from the digits too, but on their own key each is a single
                 press with A, and @ and brackets are wanted often enough to earn that -->
            <UniformGrid x:Name="SymbolsRow3" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button Style="{StaticResource LetterKeyStyle}" Content="!" Click="KeyButton_Click" Tag="!"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content="@" Click="KeyButton_Click" Tag="@"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content="£" Click="KeyButton_Click" Tag="£"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content="&amp;" Click="KeyButton_Click" Tag="&amp;"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content="(" Click="KeyButton_Click" Tag="("/>
                <Button Style="{StaticResource LetterKeyStyle}" Content=")" Click="KeyButton_Click" Tag=")"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content=":" Click="KeyButton_Click" Tag=":"/>
                <Button Style="{StaticResource LetterKeyStyle}" Content="&quot;" Click="KeyButton_Click" Tag="&quot;"/>
                <Button Style="{StaticResource FunctionKeyStyle}" Content="PgUp" Click="PageUpButton_Click"/>
                <Button Style="{StaticResource FunctionKeyStyle}" Content="PgDn" Click="PageDownButton_Click"/>
            </UniformGrid>
            <UniformGrid x:Name="EmojiRow3" Grid.Column="1" Rows="1" Columns="10" Visibility="Collapsed">
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F917;" ToolTip="Hugging face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f917.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F609;" ToolTip="Winking face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f609.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F382;" ToolTip="Birthday cake"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f382.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F914;" ToolTip="Thinking face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f914.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F44F;" ToolTip="Clapping hands"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f44f.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F642;" ToolTip="Slightly smiling face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f642.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F633;" ToolTip="Flushed face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f633.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F973;" ToolTip="Partying face"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f973.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F60E;" ToolTip="Smiling face with sunglasses"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f60e.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                <Button Style="{StaticResource EmojiKeyStyle}" Click="EmojiKey_Click" Tag="&#x1F44C;" ToolTip="Ok hand"><Image Source="pack://application:,,,/HIDra.UI;component/Emoji/1f44c.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
            </UniformGrid>
            <!-- Del under Backspace: that edge of the board is where text is removed -->
            <Button Grid.Column="2" Style="{StaticResource FunctionKeyStyle}" Content="Del" Click="DeleteButton_Click"/>
        </Grid>

        <!-- Row 4: the same on both layers. Home and End earn their place - without
             them, reaching the start of a line costs one arrow press per character. The
             arrows run in a line; an inverted T needed a key from the row above. -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LayerKey" Grid.Column="0" Style="{StaticResource FunctionKeyStyle}" Content="123 #+" Click="LayerKey_Click"/>
            <Button Grid.Column="1" x:Name="CtrlKey" Style="{StaticResource FunctionKeyStyle}" Content="Ctrl" Click="CtrlButton_Click"/>
            <Button Grid.Column="2" x:Name="SpaceKey" Style="{StaticResource FunctionKeyStyle}" Click="SpaceButton_Click">
                <StackPanel>
                    <TextBlock Text="━━━ Space ━━━" HorizontalAlignment="Center"/>
                    <TextBlock Text="RB" FontSize="12" FontWeight="SemiBold" Foreground="#FFC27A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource FunctionKeyStyle}" Content="Home" Click="HomeButton_Click"/>
            <Button Grid.Column="4" Style="{StaticResource FunctionKeyStyle}" Content="End" Click="EndButton_Click"/>
            <Button Grid.Column="5" Style="{StaticResource FunctionGlyphKeyStyle}" Content="←" Click="ArrowLeftButton_Click"/>
            <Button Grid.Column="6" Style="{StaticResource FunctionGlyphKeyStyle}" Content="↑" Click="ArrowUpButton_Click"/>
            <Button Grid.Column="7" Style="{StaticResource FunctionGlyphKeyStyle}" Content="↓" Click="ArrowDownButton_Click"/>
            <Button Grid.Column="8" Style="{StaticResource FunctionGlyphKeyStyle}" Content="→" Click="ArrowRightButton_Click"/>
        </Grid>

        <!-- Shortcut panel. Four rows are the same everywhere, each one kind of action;
             the fifth follows the program in front and is labelled with its name. Labels
             on the keys are filled in by the code. The row words are plain text, not
             keys, so the highlight passes straight over them. -->
        <Grid x:Name="ShortcutPanel" Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="5" Columns="1">
                <TextBlock Style="{StaticResource ShortcutRowLabel}" Text="Edit" Foreground="#8FB0D0"/>
                <TextBlock Style="{StaticResource ShortcutRowLabel}" Text="Select" Foreground="#7FC2BC"/>
                <TextBlock Style="{StaticResource ShortcutRowLabel}" Text="Sound" Foreground="#AE9DD6"/>
                <TextBlock Style="{StaticResource ShortcutRowLabel}" Text="Tools" Foreground="#D492A8"/>
                <TextBlock x:Name="ProgramRowLabel" Style="{StaticResource ShortcutRowLabel}" Foreground="White"/>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Rows="5" Columns="5">
                <Button x:Name="Shortcut0" Style="{StaticResource ShortcutEditStyle}" Click="ShortcutButton_Click" Tag="0"/>
                <Button x:Name="Shortcut1" Style="{StaticResource ShortcutEditStyle}" Click="ShortcutButton_Click" Tag="1"/>
                <Button x:Name="Shortcut2" Style="{StaticResource ShortcutEditStyle}" Click="ShortcutButton_Click" Tag="2"/>
                <Button x:Name="Shortcut3" Style="{StaticResource ShortcutEditStyle}" Click="ShortcutButton_Click" Tag="3"/>
                <Button x:Name="Shortcut4" Style="{StaticResource ShortcutEditStyle}" Click="ShortcutButton_Click" Tag="4"/>
                <Button x:Name="Shortcut5" Style="{StaticResource ShortcutSelectStyle}" Click="ShortcutButton_Click" Tag="5"/>
                <Button x:Name="Shortcut6" Style="{StaticResource ShortcutSelectStyle}" Click="ShortcutButton_Click" Tag="6"/>
                <Button x:Name="Shortcut7" Style="{StaticResource ShortcutSelectStyle}" Click="ShortcutButton_Click" Tag="7"/>
                <Button x:Name="Shortcut8" Style="{StaticResource ShortcutSelectStyle}" Click="ShortcutButton_Click" Tag="8"/>
                <Button x:Name="Shortcut9" Style="{StaticResource ShortcutSelectStyle}" Click="ShortcutButton_Click" Tag="9"/>
                <Button x:Name="Shortcut10" Style="{StaticResource ShortcutStyleStyle}" Click="ShortcutButton_Click" Tag="10"/>
                <Button x:Name="Shortcut11" Style="{StaticResource ShortcutStyleStyle}" Click="ShortcutButton_Click" Tag="11"/>
                <Button x:Name="Shortcut12" Style="{StaticResource ShortcutStyleStyle}" Click="ShortcutButton_Click" Tag="12"/>
                <Button x:Name="Shortcut13" Style="{StaticResource ShortcutStyleStyle}" Click="ShortcutButton_Click" Tag="13"/>
                <Button x:Name="Shortcut14" Style="{StaticResource ShortcutStyleStyle}" Click="ShortcutButton_Click" Tag="14"/>
                <Button x:Name="Shortcut15" Style="{StaticResource ShortcutToolsStyle}" Click="ShortcutButton_Click" Tag="15"/>
                <Button x:Name="Shortcut16" Style="{StaticResource ShortcutToolsStyle}" Click="ShortcutButton_Click" Tag="16"/>
                <Button x:Name="Shortcut17" Style="{StaticResource ShortcutToolsStyle}" Click="ShortcutButton_Click" Tag="17"/>
                <Button x:Name="Shortcut18" Style="{StaticResource ShortcutToolsStyle}" Click="ShortcutButton_Click" Tag="18"/>
                <Button x:Name="Shortcut19" Style="{StaticResource ShortcutToolsStyle}" Click="ShortcutButton_Click" Tag="19"/>
                <Button x:Name="Shortcut20" Style="{StaticResource ShortcutProgramStyle}" Click="ShortcutButton_Click" Tag="20"/>
                <Button x:Name="Shortcut21" Style="{StaticResource ShortcutProgramStyle}" Click="ShortcutButton_Click" Tag="21"/>
                <Button x:Name="Shortcut22" Style="{StaticResource ShortcutProgramStyle}" Click="ShortcutButton_Click" Tag="22"/>
                <Button x:Name="Shortcut23" Style="{StaticResource ShortcutProgramStyle}" Click="ShortcutButton_Click" Tag="23"/>
                <Button x:Name="Shortcut24" Style="{StaticResource ShortcutProgramStyle}" Click="ShortcutButton_Click" Tag="24"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
