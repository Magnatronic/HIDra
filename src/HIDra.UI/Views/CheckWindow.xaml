<Window x:Class="HIDra.UI.Views.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HIDra - Check this PC" Width="900" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}">
    <!-- What HIDra can find out about why it might not work on this PC, to read here or
         copy and send to whoever looks after the PCs. -->
    <Window.Resources>
        <Style x:Key="CheckButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentOnBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Check this PC" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="What HIDra can see about this PC and where it saves settings. Copy it to send to whoever looks after the PCs."
                       FontSize="15" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CheckButton}" Content="Close" Margin="8,0,0,0" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource CheckButton}" Content="Copy" Click="Copy_Click"/>
            <TextBlock x:Name="SavedText" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>

        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="4">
            <TextBox x:Name="ReportText" IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                     Background="Transparent" Foreground="{DynamicResource BodyTextBrush}" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8"/>
        </Border>
    </DockPanel>
</Window>
