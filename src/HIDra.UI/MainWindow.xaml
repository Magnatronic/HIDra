                      <Line X1="180" Y1="280" X2="284" Y2="262" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="281" Canvas.Top="259" Width="6" Height="6" Fill="#8A9096"/>
                      <TextBlock Canvas.Left="0" Canvas.Top="259" Width="175" TextAlignment="Right" TextWrapping="Wrap" LineHeight="20"><Run Text="D-pad" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Maximise · Minimise · Snap" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <Line X1="520" Y1="100" X2="478" Y2="111" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="475" Canvas.Top="108" Width="6" Height="6" Fill="#8A9096"/>
                      <TextBlock Canvas.Left="525" Canvas.Top="79" Width="205" TextAlignment="Left" TextWrapping="Wrap" LineHeight="20"><Run Text="RT" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Hold: click and drag" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <Line X1="520" Y1="152" X2="490" Y2="138" Stroke="#8A9096" StrokeThickness="1.5"/>
