<Window x:Class="HIDra.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HIDra.UI"
        xmlns:views="clr-namespace:HIDra.UI.Views"
        mc:Ignorable="d"
        Title="HIDra - Controller to Mouse/Keyboard"
        Height="900" Width="1600"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1B1B1B">

    <!--
        One layout, 1280 by 720, scaled as a whole to fill the window. Every page is
        designed once at that size, so nothing reflows, shrinks or ends up lopsided on a
        different screen - it is simply bigger on a big one. Three tabs:

          Guide      what every button does, and "How do I..." for everyday tasks
          Practice   two repeatable tests, and the record of every run
          Settings   a list down the left: Buttons, Pointer, Keyboard, Shortcut keys,
                     Apps, Phrases, General

        One small set of parts is used everywhere: page tabs, a side list, cards, setting
        rows with one control each, On/Off switches, steppers with a level bar, and a
        segmented control for choosing one of a few. Choosing a job, a shortcut key or a
        program opens a panel over the page.

        Everything is aimed at with the pointer the controller drives, so every control
        is large and well spaced, and shows the pointer is over it with an orange border.
    -->
    <Window.Resources>
        <!--
            The design system, in one place. Sizes are in the 1280x720 layout, which is scaled
            to the screen.

              Type    section title 22, card title 18, setting and body 16, hint 13.5
              Space   steps of 8: 8 between related things, 16 between groups
              Colour  cards #232323 on #1B1B1B; orange border = where the pointer is,
                      orange fill = chosen or on (App.xaml)
        -->
        <SolidColorBrush x:Key="CardBrush" Color="#232323"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#B4B4B4"/>

        <!-- Text -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Kept by the name the code uses for card titles -->
        <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}"/>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Surfaces -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}"/>
        <Style x:Key="StartPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="28,22"/>
            <Setter Property="Width" Value="540"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Buttons. Every one: a thick orange border under the pointer, orange fill while
             pressed or chosen. -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentOnBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A command: Start, Reset, Export... -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentOnBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- The - and + of a stepper -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Where a stepper's value sits, least to most -->
        <Style x:Key="LevelTrack" TargetType="Border">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="LevelFill" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="0"/>
        </Style>

        <!-- On/Off: a switch with its word beside it, never colour alone. The code sets Tag
             to "on" or "off", and the word. -->
        <Style x:Key="Switch" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="track" Width="68" Height="36" CornerRadius="18" Background="{TemplateBinding Background}"
                                    BorderBrush="#777777" BorderThickness="2">
                                <Ellipse x:Name="knob" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentOnBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="track" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Choosing one of a few: a pill of options, the chosen one filled orange. The code
             sets the chosen one's Background. -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style x:Key="Segment" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19"
                                BorderBrush="Transparent" BorderThickness="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page tabs: a word with a bar under it, orange for the page showing. The code
             sets the bar (Background) and the word's colour. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="#01000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="hover" Height="3" VerticalAlignment="Bottom" Opacity="0" Background="{StaticResource AccentBrush}"/>
                            <Border x:Name="bar" Height="5" VerticalAlignment="Bottom" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="hover" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Settings list: an orange bar at the left of the section showing -->
        <Style x:Key="SideNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="row" Background="#01000000">
                            <Border x:Name="bar" Width="5" HorizontalAlignment="Left" Background="{TemplateBinding Background}" Margin="0,8"/>
                            <Border x:Name="hover" BorderBrush="Transparent" BorderThickness="3" CornerRadius="8" Margin="8,2"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="22,0,8,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kept for older code paths: a plain choice button -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>

        <!-- A key in the shortcut and Apps editors: an icon or logo above a word -->
        <Style x:Key="EditorKey" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <!-- Fills its place in the editor, which fills the page -->
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="ChoiceKey" TargetType="Button" BasedOn="{StaticResource EditorKey}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="100"/>
        </Style>
        <!-- A job in the job list -->
        <Style x:Key="JobChoice" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PhraseBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Scroll bars: wide, with a bright thumb that turns orange under the pointer -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Background="#B8B8B8" CornerRadius="8" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#333333" CornerRadius="11">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinHeight="40"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="#333333" CornerRadius="11">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" MinWidth="40"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "How do I..." questions, opened by clicking. Orange border under the pointer. -->
        <Style x:Key="HowToCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HowToTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="HowToText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#D0D4D8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="26"/>
        </Style>
    </Window.Resources>


    <!-- Fills the window, so its size is the window's: the layout takes its shape -->
    <Grid x:Name="Scaler" SizeChanged="Scaler_SizeChanged">
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Layout" Width="1280" Height="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Whether it is working, and the one button that stops it: on every page -->
            <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                        <!-- The full-size logo, smoothly scaled: the .ico's small frames looked blocky here -->
                        <Image Source="HIDra-logo.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="HIDra" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse x:Name="StatusIndicator" Width="14" Height="14" Fill="#DC3545" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#DC3545" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ControllerInfo" Text="No controller detected" FontSize="13" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        <!-- Battery, so a low battery is seen before it fails -->
                        <TextBlock x:Name="BatteryText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource ActionButton}" Content="Pause" MinWidth="110"
                            IsEnabled="False" VerticalAlignment="Center" Click="StopButton_Click"/>
                </Grid>
            </Border>

            <!-- The pages. Settings sits apart from the two for everyday use. -->
            <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,2,16,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GuideTabButton" Style="{StaticResource TabButton}" Content="Guide" Tag="Guide" Click="Tab_Click"/>
                    <Button x:Name="PracticeTabButton" Style="{StaticResource TabButton}" Content="Practice" Tag="Practice" Click="Tab_Click"/>
                    <Border Width="2" Background="#3A3A3A" Margin="16,12,16,12"/>
                    <Button x:Name="SettingsTabButton" Style="{StaticResource TabButton}" Content="Settings" Tag="Settings" Click="Tab_Click"/>
                </StackPanel>
            </Border>

            <!-- ============================== Guide ============================== -->
            <Grid x:Name="GuidePage" Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="What each button does" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Press a button on the controller to see it light up" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <!-- Follows the keyboard: typing while it is open, the pointer while
                                 it is closed. Can be flipped to look ahead. -->
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ModePointerButton" Style="{StaticResource Segment}" Content="Using the pointer" Click="ModePointer_Click"/>
                                    <Button x:Name="ModeTypingButton" Style="{StaticResource Segment}" Content="Typing" Click="ModeTyping_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <views:ControllerDrawing x:Name="GuideDrawing" Grid.Row="1"/>
                    </Grid>
                </Border>

                <!-- How do I... One question open at a time, so they always fit -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,14,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="How do I..." Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="HowToModeText" Style="{StaticResource SettingHint}"/>
                        </StackPanel>
                        <Grid>
                            <StackPanel x:Name="HowToPointer">
                                <Border x:Name="HowToLeftTrigger" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="HowToLeftTriggerTitle" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LT"/></InlineUIContainer><Run x:Name="HowToLeftTriggerText"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToClick" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Click on something" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToClickText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToScroll" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Scroll a page" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToScrollText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToWindows" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Arrange windows" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToWindowsText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToSwitch" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Switch programs" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToSwitchText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToOpen" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToOpenText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToStartTyping" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Start typing" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToStartTypingText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="HowToTyping" Visibility="Collapsed">
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Steer the orange box with the left stick."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="types the key, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeB}"/></InlineUIContainer><Run Text="types a capital or the symbol on top."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type faster" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LB"/></InlineUIContainer><Run Text="deletes, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="RB"/></InlineUIContainer><Run Text="space, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeY}"/></InlineUIContainer><Run Text="Enter."/><LineBreak/><Run Text="Push the right stick to jump: up to the green words, right to the shortcuts."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Fix a mistake" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="The D-pad, left and right, moves the text cursor to it."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LB"/></InlineUIContainer><Run Text="deletes the letter before the cursor."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type numbers and symbols" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Press the left stick in, or go to 123 #+ at the bottom left. Press it again for the letters."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="Start"/></InlineUIContainer><Run Text="turns Caps Lock on and off."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type a saved phrase" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go up to Phrases, at the start of the green row, and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="- then pick the phrase. Phrases are set in Settings."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- Only for a student whose keyboard has the Read key -->
                                <Border x:Name="HowToReadAloud" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Hear it read aloud" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Select the words, then press Read in the Tools row. Press Read again to stop."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Copy and paste" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Select, then move to highlight the text, then Copy. Go to where it belongs, then Paste."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToKeyboardWay" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Keyboard in the way?" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToKeyboardWayText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go to Apps at the top left and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="on the program."/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================= Practice ============================= -->
            <!-- Two tests, each the same every time at a size or level, so one run
                 compares with the last. Every run is kept, for reviews. -->
            <Grid x:Name="PracticePage" Grid.Row="2" Margin="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ActivityPointerButton" Style="{StaticResource Segment}" MinWidth="150" Content="Pointer test" Tag="Pointer" Click="Activity_Click"/>
                                    <Button x:Name="ActivityTypingButton" Style="{StaticResource Segment}" MinWidth="150" Content="Typing test" Tag="Typing" Click="Activity_Click"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ActivityScore" Style="{StaticResource SettingHint}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Pointer test: a tall page of circles, one at a time. Some are further
                             down or up, so reaching them means scrolling as well as pointing. -->
                        <Grid x:Name="PointerActivity" Grid.Row="1">
                            <ScrollViewer x:Name="PointerScroll" VerticalScrollBarVisibility="Visible" ScrollChanged="PointerScroll_ScrollChanged"
                                          SizeChanged="PointerScroll_SizeChanged">
                                <Canvas x:Name="PointerCanvas" Background="#2A2A2A" ClipToBounds="True" MouseLeftButtonDown="PointerCanvas_MouseDown"/>
                            </ScrollViewer>
                            <Border x:Name="ScrollHintTop" Background="{StaticResource AccentOnBrush}" CornerRadius="0,0,10,10" Padding="24,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#x2191;  Scroll up  &#x2191;" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border x:Name="ScrollHintBottom" Background="{StaticResource AccentOnBrush}" CornerRadius="10,10,0,0" Padding="24,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="&#x2193;  Scroll down  &#x2193;" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border x:Name="PointerStartPanel" Style="{StaticResource StartPanel}">
                                <StackPanel>
                                    <TextBlock x:Name="PointerStartTitle" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                                    <TextBlock x:Name="PointerStartText" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,10,0,20"/>
                                    <Button x:Name="PointerStartButton" Style="{StaticResource PrimaryButton}" Content="Start" Click="PointerStart_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Typing test: an item to type in a box at the top of the page for one
                             and the bottom for the next, so the keyboard is sometimes in the way -->
                        <Grid x:Name="TypingActivity" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Level" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Style="{StaticResource SegmentBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TypingLevel0" Style="{StaticResource Segment}" Content="Words" Tag="0" Click="TypingLevel_Click"/>
                                        <Button x:Name="TypingLevel1" Style="{StaticResource Segment}" Content="Phrases" Tag="1" Click="TypingLevel_Click"/>
                                        <Button x:Name="TypingLevel2" Style="{StaticResource Segment}" Content="Sentences" Tag="2" Click="TypingLevel_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8" Padding="24,16">
                                <Grid>
                                    <StackPanel x:Name="TypingItem" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="TypingTarget" FontSize="40" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <TextBox x:Name="TypingBox" Width="640" Height="56" FontSize="26" TextAlignment="Center" Margin="0,10,0,0"
                                                 VerticalContentAlignment="Center" Background="#3C3C3C" Foreground="White" CaretBrush="White"
                                                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" TextChanged="TypingBox_TextChanged"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Skip" Click="TypingSkip_Click"/>
                                            <TextBlock x:Name="TypingHint" Style="{StaticResource SettingHint}" FontSize="14.5" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="TypingMessage" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Border x:Name="TypingStartPanel" Style="{StaticResource StartPanel}">
                                        <StackPanel>
                                            <TextBlock x:Name="TypingStartTitle" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
                                            <TextBlock x:Name="TypingStartText" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,10,0,20"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Start" Click="TypingStart_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- The record: the latest runs of each test -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Progress" Style="{StaticResource CardTitle}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SettingHint}" Margin="0,4,0,4"
                                   Text="Every run is kept with these settings, to look back on."/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Content="Save as a spreadsheet..." Click="ExportProgress_Click"/>
                            <TextBlock x:Name="ProgressStatus" Style="{StaticResource SettingHint}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Pointer test" Style="{StaticResource SettingTitle}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="PointerBest" Style="{StaticResource SettingHint}"/>
                            <Grid x:Name="PointerTable" Margin="0,4,0,0"/>
                            <TextBlock Text="Typing test" Style="{StaticResource SettingTitle}" Margin="0,16,0,0"/>
                            <TextBlock x:Name="TypingBest" Style="{StaticResource SettingHint}"/>
                            <Grid x:Name="TypingTable" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================= Settings ============================= -->
            <!-- A list down the left, the section on the right, saved as it changes -->
            <Grid x:Name="SettingsPage" Grid.Row="2" Margin="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Changes are saved as they are made." Style="{StaticResource SettingHint}"
                                   Margin="20,0,16,4"/>
                        <StackPanel>
                            <Button x:Name="NavButtons" Style="{StaticResource SideNavItem}" Content="Buttons" Tag="Buttons" Click="SettingsNav_Click"/>
                            <Button x:Name="NavPointer" Style="{StaticResource SideNavItem}" Content="Pointer" Tag="Pointer" Click="SettingsNav_Click"/>
                            <Button x:Name="NavKeyboard" Style="{StaticResource SideNavItem}" Content="Keyboard" Tag="Keyboard" Click="SettingsNav_Click"/>
                            <Button x:Name="NavShortcuts" Style="{StaticResource SideNavItem}" Content="Shortcut keys" Tag="Shortcuts" Click="SettingsNav_Click"/>
                            <Button x:Name="NavApps" Style="{StaticResource SideNavItem}" Content="Apps" Tag="Apps" Click="SettingsNav_Click"/>
                            <Button x:Name="NavPhrases" Style="{StaticResource SideNavItem}" Content="Phrases" Tag="Phrases" Click="SettingsNav_Click"/>
                            <Button x:Name="NavGeneral" Style="{StaticResource SideNavItem}" Content="General" Tag="General" Click="SettingsNav_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <!-- Buttons -->
                    <Grid x:Name="ButtonsSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Click a label, or the button itself, to choose its job. These are the jobs while the keyboard is closed." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionButton}" Content="Reset all" Click="ButtonsStandard_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <views:ControllerDrawing x:Name="JobsDrawing" Margin="0,0,0,44"/>
                            <!-- Every button changed from its default, one click from its jobs -->
                            <DockPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Changed:" Style="{StaticResource SettingHint}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <WrapPanel x:Name="JobChangedList"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <!-- Pointer -->
                    <Grid x:Name="PointerSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Pointer" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="How the pointer moves and clicks. Try a change straight away with the pointer test on the Practice tab." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Moving" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                        <UniformGrid Columns="1">
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Pointer speed" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Left stick. Slower is easier to control" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="CursorSlower_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="CursorSpeedValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="CursorSpeedValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="CursorFaster_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Scroll speed" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Right stick" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="ScrollSlower_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ScrollSpeedValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="ScrollSpeedValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="ScrollFaster_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Pointer feel" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Gentle: slower for a small push, faster for a big one" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="CurveSteadyButton" Style="{StaticResource Segment}" MinWidth="94" Content="Steady" Click="CurveSteady_Click"/>
                                                            <Button x:Name="CurveGentleButton" Style="{StaticResource Segment}" MinWidth="94" Content="Gentle" Click="CurveGentle_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Slow pointer speed" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Share of normal speed while Slow pointer is on" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="SlowPointerSlower_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="SlowPointerValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="SlowPointerValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="SlowPointerFaster_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Steadiness and clicking" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="1">
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Smooth out wobbles" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="Steadies a shaky stick. More lags a little" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="SmoothingLess_Click"/>
                                                            <StackPanel Width="96" VerticalAlignment="Center">
                                                                <TextBlock x:Name="SmoothingValue" Style="{StaticResource ValueText}"/>
                                                                <Border Style="{StaticResource LevelTrack}">
                                                                    <Border x:Name="SmoothingValueBar" Style="{StaticResource LevelFill}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Style="{StaticResource StepButton}" Content="+" Click="SmoothingMore_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Ignore quick repeat presses" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="A press this soon after letting go is ignored" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="RepeatShorter_Click"/>
                                                            <StackPanel Width="96" VerticalAlignment="Center">
                                                                <TextBlock x:Name="IgnoreRepeatValue" Style="{StaticResource ValueText}"/>
                                                                <Border Style="{StaticResource LevelTrack}">
                                                                    <Border x:Name="IgnoreRepeatValueBar" Style="{StaticResource LevelFill}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Style="{StaticResource StepButton}" Content="+" Click="RepeatLonger_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Click by resting" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="Clicks when the pointer stops, instead of A" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <Button x:Name="DwellClickToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="DwellClickToggle_Click"/>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Resting time" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="How long the pointer rests before it clicks" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="DwellClickShorter_Click"/>
                                                            <StackPanel Width="96" VerticalAlignment="Center">
                                                                <TextBlock x:Name="DwellClickValue" Style="{StaticResource ValueText}"/>
                                                                <Border Style="{StaticResource LevelTrack}">
                                                                    <Border x:Name="DwellClickValueBar" Style="{StaticResource LevelFill}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Style="{StaticResource StepButton}" Content="+" Click="DwellClickLonger_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </UniformGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- Keyboard -->
                    <Grid x:Name="KeyboardSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Keyboard" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="KeyboardButtonHint" Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="How it looks" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                        <UniformGrid Columns="1">
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Size" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Bigger keys and text" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="KeyboardSmaller_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="KeyboardSizeValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="KeyboardSizeValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="KeyboardBigger_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Where it opens" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="Tap LT to move it while it is open" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="KeyboardTopButton" Style="{StaticResource Segment}" MinWidth="94" Content="Top" Click="KeyboardTop_Click"/>
                                                            <Button x:Name="KeyboardBottomButton" Style="{StaticResource Segment}" MinWidth="94" Content="Bottom" Click="KeyboardBottom_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Fade when resting" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="See the text behind it" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <Button x:Name="KeyboardFadeToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="KeyboardFadeToggle_Click"/>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Fade after" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="How long before it fades" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="KeyboardFadeShorter_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="KeyboardFadeValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="KeyboardFadeValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="KeyboardFadeLonger_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Faded keyboard shows" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="How much stays visible" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="KeyboardFadeFainter_Click"/>
                                                        <StackPanel Width="96" VerticalAlignment="Center">
                                                            <TextBlock x:Name="KeyboardFadeOpacityValue" Style="{StaticResource ValueText}"/>
                                                            <Border Style="{StaticResource LevelTrack}">
                                                                <Border x:Name="KeyboardFadeOpacityValueBar" Style="{StaticResource LevelFill}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Style="{StaticResource StepButton}" Content="+" Click="KeyboardFadeStronger_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Typing help" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="1">
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Type by resting" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="Types the key the orange box rests on" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <Button x:Name="KeyboardDwellToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="KeyboardDwellToggle_Click"/>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Resting time" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="How long the box rests before it types" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource StepButton}" Content="&#x2212;" Click="KeyboardDwellShorter_Click"/>
                                                            <StackPanel Width="96" VerticalAlignment="Center">
                                                                <TextBlock x:Name="KeyboardDwellValue" Style="{StaticResource ValueText}"/>
                                                                <Border Style="{StaticResource LevelTrack}">
                                                                    <Border x:Name="KeyboardDwellValueBar" Style="{StaticResource LevelFill}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Style="{StaticResource StepButton}" Content="+" Click="KeyboardDwellLonger_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Capitals automatically" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="Starts sentences, and I, with a capital" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <Button x:Name="AutoCapitalToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="AutoCapitalToggle_Click"/>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#333333" BorderThickness="0">
                                                    <Grid Style="{StaticResource SettingRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="200"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Shortcut panel" Style="{StaticResource SettingTitle}"/>
                                                            <TextBlock Text="The shortcut keys beside the keyboard" Style="{StaticResource SettingHint}"/>
                                                        </StackPanel>
                                                        <Button x:Name="ShortcutsToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="ShortcutsToggle_Click"/>
                                                    </Grid>
                                                </Border>
                                            </UniformGrid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- Shortcut keys -->
                    <Grid x:Name="ShortcutsSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Shortcut keys" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Beside the keyboard, one press each. Click a key to change it, or to leave its place empty. The row below them on the keyboard follows the program in front." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionButton}" Content="Reset" Click="ShortcutsStandard_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Border Style="{StaticResource Card}">
                                <UniformGrid x:Name="ShortcutEditor" Columns="1"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- Apps -->
                    <Grid x:Name="AppsSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Apps" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="The programs the keyboard's Apps key opens in one press. Click one to change it: any program on the Start menu, Store apps included." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionButton}" Content="Reset" Click="AppsStandard_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Border Style="{StaticResource Card}">
                                <UniformGrid x:Name="AppEditor" Columns="3" Rows="2"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- Phrases -->
                    <Grid x:Name="PhrasesSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="Phrases" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Typed whole from the keyboard's Phrases key: a name, an email address, a sentence used often." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Border Style="{StaticResource Card}">
                                <UniformGrid Columns="1">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="1" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase0" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="0" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="2" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase1" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="1" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="3" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase2" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="2" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="4" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase3" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="3" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="5" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase4" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="4" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="6" Style="{StaticResource CardTitle}" Width="32" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Phrase5" Style="{StaticResource PhraseBox}" Height="52" FontSize="18" Tag="5" TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                    </DockPanel>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- General -->
                    <Grid x:Name="GeneralSection" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,280,0">
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Other programs, and the settings file." Style="{StaticResource SectionHint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Other programs" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                        <UniformGrid Columns="1">
                                            <Border BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Pause while Grid 3 is open" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="So the two do not fight over the pointer" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <Button x:Name="Grid3Toggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Grid3Toggle_Click"/>
                                                </Grid>
                                            </Border>
                                            <Border BorderBrush="#333333" BorderThickness="0">
                                                <Grid Style="{StaticResource SettingRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="200"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Block the Windows keyboard" Style="{StaticResource SettingTitle}"/>
                                                        <TextBlock Text="It pops up and takes over the controller" Style="{StaticResource SettingHint}"/>
                                                    </StackPanel>
                                                    <Button x:Name="StopWindowsKeyboardToggle" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="StopWindowsKeyboardToggle_Click"/>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </DockPanel>
                                </Border>
                                <Grid Height="16"/>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Settings file" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                        <StackPanel>
                                            <TextBlock Text="Settings are saved as they change." Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="SettingsLocationText" Style="{StaticResource SettingHint}" Margin="0,4,0,14"/>
                                            <TextBlock Text="To use the same settings for someone else, export them here, then import them while they are logged in." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ActionButton}" Content="Export..." Click="ExportSettings_Click"/>
                                                <Button Style="{StaticResource ActionButton}" Content="Import..." Click="ImportSettings_Click" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ExportImportStatus" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Choosing: a button's job, a shortcut key or a program opens here, over
                         the section. The dark edge, or Close, puts it away. -->
                    <Grid x:Name="SheetOverlay" Background="#D8101010" Visibility="Collapsed" MouseLeftButtonUp="SheetOverlay_MouseUp">
                        <Border x:Name="Sheet" Style="{StaticResource Card}" Background="#262626" BorderBrush="#555555" BorderThickness="2"
                                Margin="24,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock x:Name="SheetTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Content="Close" Click="SheetClose_Click"/>
                                </Grid>

                                <Grid>
                                <!-- A button's job -->
                                <DockPanel x:Name="JobSheet">
                                    <!-- What the job under the pointer does. A fixed height, so pointing at
                                         a job never moves the jobs (which made them flicker). -->
                                    <Border DockPanel.Dock="Bottom" Background="#303030" CornerRadius="6" Padding="12,0" Height="44" Margin="0,10,0,0">
                                        <TextBlock x:Name="JobHoverText" FontSize="14.5" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="JobCard" DockPanel.Dock="Top" Background="#303030" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="JobBadgeHost" VerticalAlignment="Top" Margin="0,4,14,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="JobCurrentText" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="JobDoesText" FontSize="14.5" Foreground="#DDDDDD" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="JobTypingText" FontSize="14.5" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="JobStandardText" FontSize="14.5" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="JobResetButton" Grid.Column="2" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom"
                                                    Content="Reset" Click="JobReset_Click"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="JobLockedText" DockPanel.Dock="Top" Foreground="{StaticResource WarningBrush}" FontSize="14.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <!-- Which of the D-pad or stick presses; and everyday jobs or Windows tools -->
                                    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                                        <Border x:Name="JobPartsBar" Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                                            <StackPanel x:Name="JobParts" Orientation="Horizontal"/>
                                        </Border>
                                        <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Right">
                                            <StackPanel x:Name="JobPages" Orientation="Horizontal"/>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="JobChoices" Margin="0,10,0,0"/>
                                </DockPanel>

                                <!-- A shortcut key or a program -->
                                <DockPanel x:Name="KeySheet" Visibility="Collapsed">
                                    <DockPanel x:Name="AppSearchRow" DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Find" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="AppSearchBox" Style="{StaticResource PhraseBox}" TextChanged="AppSearchBox_TextChanged"/>
                                    </DockPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="KeyChoices"/>
                                    </ScrollViewer>
                                </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
    </Grid>
</Window>
