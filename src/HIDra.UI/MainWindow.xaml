                      <Rectangle Canvas.Left="204" Canvas.Top="200" Width="292" Height="64" Fill="#3A3F44"/>
                      <Ellipse Canvas.Left="192" Canvas.Top="215" Width="104" Height="123" Fill="#3A3F44"/>
                      <Ellipse Canvas.Left="404" Canvas.Top="215" Width="104" Height="123" Fill="#3A3F44"/>
                      <Rectangle Canvas.Left="222" Canvas.Top="98" Width="62" Height="26" RadiusX="9" RadiusY="9" Fill="#50575E" Stroke="#6B7278"/>
