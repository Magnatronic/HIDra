                      <TextBlock Canvas.Left="525" Canvas.Top="131" Width="205" TextAlignment="Left" TextWrapping="Wrap" LineHeight="20"><Run Text="RB" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Double click" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
