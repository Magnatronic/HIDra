                      <TextBlock Canvas.Left="0" Canvas.Top="79" Width="175" TextAlignment="Right" TextWrapping="Wrap" LineHeight="20"><Run Text="LT" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Move keyboard up / down" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <Line X1="180" Y1="152" X2="210" Y2="138" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="207" Canvas.Top="135" Width="6" Height="6" Fill="#8A9096"/>
                      <TextBlock Canvas.Left="0" Canvas.Top="131" Width="175" TextAlignment="Right" TextWrapping="Wrap" LineHeight="20"><Run Text="LB" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Window switcher" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <Line X1="180" Y1="210" X2="236" Y2="205" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="233" Canvas.Top="202" Width="6" Height="6" Fill="#8A9096"/>
