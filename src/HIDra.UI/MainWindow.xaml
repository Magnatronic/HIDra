<Window x:Class="HIDra.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HIDra.UI"
        xmlns:views="clr-namespace:HIDra.UI.Views"
        mc:Ignorable="d"
        Title="HIDra - Controller to Mouse/Keyboard"
        Height="900" Width="1600"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1B1B1B">

    <!--
        Four pages, split by who they are for:

          Guide       for the student, and what opens: a controller drawing labelled with
                      what every button does - using the pointer, or typing - with each
                      button lighting up orange as it is pressed, and "How do I..." beside
                      it for everyday tasks.
          Practice    for the student, and for staff trying a setting: a circle to click
                      that shrinks, a word to type, the keyboard to open and close, a
                      list to scroll - and the record of each day's practice.
          Controller  for staff: each button's job, on the same drawing as the Guide,
                      the pointer, and this student's settings file, to copy to another
                      student.
          Keyboard    for staff: the keyboard, phrases, and Windows' own keyboard.

        Everything on one page was too much at once. Whether the controller is
        connected, and Pause, stay in the bar above them all.

        Everything is aimed at with the pointer the controller drives, so every control
        is large, well spaced, and shows the pointer is over it with a thick orange
        border. It opens maximised.
    -->
    <Window.Resources>

        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentOnBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off and choice buttons: the code paints them orange when selected -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- The two pages. Orange for the one showing, like any other choice here. -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- A key in the shortcut and Apps editors: an icon or logo above a word, like the
             key it stands for on the keyboard -->
        <Style x:Key="EditorKey" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="ChoiceKey" TargetType="Button" BasedOn="{StaticResource EditorKey}">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="104"/>
        </Style>

        <!-- A job a controller button can be given, on the Controller tab -->
        <Style x:Key="JobChoice" TargetType="Button" BasedOn="{StaticResource EditorKey}">
            <Setter Property="Width" Value="164"/>
            <Setter Property="Height" Value="80"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="70"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="MinHeight" Value="50"/>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PhraseBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style x:Key="HowToCard" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HowToTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="HowToText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#D0D4D8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="27"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status bar: is it working, and the one button that stops it. Above both
             pages, so it is always in view. -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Image Source="HIDra.ico" Width="36" Height="36" Margin="0,0,10,0"/>
                    <TextBlock Text="HIDra" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="#DC3545" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#DC3545" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ControllerInfo" Text="No controller detected" FontSize="14"
                               Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    <!-- Battery state, so staff can see at the start of a session whether the
                         controller will last, and so a low battery is visible before it fails. -->
                    <TextBlock x:Name="BatteryText" Text="" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CCCCCC" Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource BigButton}"
                        Content="Pause" Width="120" FontSize="18" IsEnabled="False"
                        Margin="20,0,0,0" Click="StopButton_Click"/>
            </Grid>
        </Border>

        <!-- The pages. The student's two come first; the settings, for staff, sit apart
             after them, so it is plain which are which. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,14,16,0">
            <Button x:Name="GuideTabButton" Style="{StaticResource TabButton}" Content="Guide" Tag="Guide" Click="Tab_Click"/>
            <Button x:Name="PracticeTabButton" Style="{StaticResource TabButton}" Content="Practice" Tag="Practice" Click="Tab_Click"/>
            <Border Width="2" Background="#3A3A3A" Margin="22,6,18,6"/>
            <TextBlock Text="Settings" FontSize="15" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="ControllerTabButton" Style="{StaticResource TabButton}" Content="Controller" Tag="Controller" Click="Tab_Click"/>
            <Button x:Name="KeyboardTabButton" Style="{StaticResource TabButton}" Content="Keyboard" Tag="Keyboard" Click="Tab_Click"/>
        </StackPanel>

        <!-- ============================== Guide ============================== -->
        <Grid x:Name="GuidePage" Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- What every button does -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="What each button does" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Press a button on the controller to see it light up" Style="{StaticResource SettingHint}" FontSize="14"/>
                        </StackPanel>
                        <!-- Follows the keyboard: typing while it is open, the pointer while
                             it is closed. Staff can flip it to look ahead. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ModePointerButton" Style="{StaticResource ToggleButtonStyle}" Width="170" FontSize="16"
                                    Content="Using the pointer" Click="ModePointer_Click"/>
                            <Button x:Name="ModeTypingButton" Style="{StaticResource ToggleButtonStyle}" Width="120" FontSize="16"
                                    Content="Typing" Click="ModeTyping_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- The Viewbox scales the drawing to the space available, so it stays
                         whole on a small laptop screen -->
                    <views:ControllerDrawing x:Name="GuideDrawing" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- How do I... The everyday questions, a line or two each, with the buttons
                 drawn as they look on the controller -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14,12,14,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="How do I..." Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="HowToModeText" Style="{StaticResource SettingHint}" FontSize="14"/>
                    </StackPanel>
                    <!-- One set of cards for each side of the switch, so only what can be
                         done right now is shown -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="HowToPointer">
                                <Border x:Name="HowToLeftTrigger" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="HowToLeftTriggerTitle" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LT"/></InlineUIContainer><Run x:Name="HowToLeftTriggerText"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToClick" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Click on something" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToClickText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToScroll" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Scroll a page" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToScrollText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToWindows" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Arrange windows" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToWindowsText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToSwitch" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Switch programs" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToSwitchText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToOpen" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToOpenText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToStartTyping" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Start typing" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToStartTypingText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="HowToTyping" Visibility="Collapsed">
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Steer the orange box with the left stick."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="types the key, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeB}"/></InlineUIContainer><Run Text="types a capital or the symbol on top."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type faster" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LB"/></InlineUIContainer><Run Text="deletes, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="RB"/></InlineUIContainer><Run Text="space, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeY}"/></InlineUIContainer><Run Text="Enter."/><LineBreak/><Run Text="Push up from the top row to pick a green word."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type numbers and symbols" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go to 123 #+ at the bottom left and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><LineBreak/><Run Text="abc, in the same place, brings the letters back."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type a saved phrase" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go up to Phrases, at the start of the green row, and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="- then pick the phrase. Staff set them on the Keyboard tab."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- Only for a student whose keyboard has the Read key -->
                                <Border x:Name="HowToReadAloud" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Hear it read aloud" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Select the words, then press Read in the Tools row. Press Read again to stop."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Copy and paste" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Select, then move to highlight the text, then Copy. Go to where it belongs, then Paste."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="HowToKeyboardWay" Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Keyboard in the way?" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock x:Name="HowToKeyboardWayText" Style="{StaticResource HowToText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go to Apps at the top left and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="on the program."/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================= Practice ============================= -->
        <!-- For the student to practise, and for staff to try a setting straight after
             changing it. Three activities, each a little harder as the student gets
             better, and a record of each day's practice for reviews. -->
        <Grid x:Name="PracticePage" Grid.Row="2" Margin="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Which activity -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="ActivityCirclesButton" Style="{StaticResource ToggleButtonStyle}" Width="170" Content="Circles"
                                Tag="Circles" Click="Activity_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ActivityWordButton" Style="{StaticResource ToggleButtonStyle}" Width="190" Content="Type the word"
                                Tag="Word" Click="Activity_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ActivityKeyboardButton" Style="{StaticResource ToggleButtonStyle}" Width="250" Content="Keyboard on and off"
                                Tag="Keyboard" Click="Activity_Click"/>
                    </StackPanel>

                    <!-- Circles: one at a time, smaller after five hits with at most one miss,
                         bigger again after a run of misses -->
                    <Grid x:Name="CirclesActivity" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Click the circle" Style="{StaticResource PanelTitle}"/>
                                <TextBlock x:Name="TargetScore" Style="{StaticResource SettingHint}" FontSize="16"/>
                            </StackPanel>
                            <!-- How small the circle has got: one dot per size, filled up to now -->
                            <StackPanel x:Name="CircleLevelDots" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Grid.Column="2" Style="{StaticResource ToggleButtonStyle}" Width="160" Content="Biggest again" Click="TargetReset_Click"/>
                        </Grid>
                        <!-- Clicks on the circle are hits; clicks anywhere else in the box are misses -->
                        <Border x:Name="TargetArea" Grid.Row="1" Background="#262626" CornerRadius="8" ClipToBounds="True"
                                MouseLeftButtonDown="TargetArea_MouseDown">
                            <Grid>
                                <Canvas x:Name="TargetCanvas" SizeChanged="TargetCanvas_SizeChanged"/>
                                <!-- Says when the circle changes size. Seen, not heard. -->
                                <TextBlock x:Name="CircleMessage" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Type the word: the letters turn orange as they are typed right -->
                    <Grid x:Name="WordActivity" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="#262626" CornerRadius="8" Padding="24">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                                <TextBlock x:Name="WordScore" Style="{StaticResource SettingHint}" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WordTarget" FontSize="84" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock x:Name="WordMessage" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" MinHeight="36"/>
                                <TextBlock x:Name="WordTypingHint" Style="{StaticResource SettingHint}" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                                <TextBox x:Name="WordTypingBox" Width="520" Height="68" FontSize="36" TextAlignment="Center"
                                         VerticalContentAlignment="Center" Background="#3C3C3C" Foreground="White" CaretBrush="White"
                                         BorderBrush="#666666" BorderThickness="2" TextChanged="WordTypingBox_TextChanged"/>
                                <Button Style="{StaticResource ToggleButtonStyle}" Width="180" Content="Another word"
                                        HorizontalAlignment="Center" Margin="0,16,0,0" Click="WordSkip_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Keyboard on and off: two steps, each lit when it is the one to do -->
                    <Grid x:Name="KeyboardActivity" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="#262626" CornerRadius="8" Padding="24">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0">
                                <TextBlock x:Name="KeyboardScore" Style="{StaticResource SettingHint}" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Border x:Name="KeyboardStepOpen" Style="{StaticResource GuideCard}" Width="560" Height="90" Margin="0,0,0,14">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="KeyboardStepOpenMark" Text="1" FontSize="34" FontWeight="Bold" Foreground="White" Width="50" TextAlignment="Center"/>
                                        <TextBlock x:Name="KeyboardStepOpenText" Style="{StaticResource CardAction}" FontSize="26"/>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="KeyboardStepClose" Style="{StaticResource GuideCard}" Width="560" Height="90">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="KeyboardStepCloseMark" Text="2" FontSize="34" FontWeight="Bold" Foreground="White" Width="50" TextAlignment="Center"/>
                                        <TextBlock x:Name="KeyboardStepCloseText" Style="{StaticResource CardAction}" FontSize="26"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="KeyboardMessage" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" Margin="0,20,0,0" MinHeight="40"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- The record, day by day, for reviews -->
                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Progress" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ToggleButtonStyle}" Width="200" FontSize="16" HorizontalAlignment="Right"
                                    Content="Save for a review..." Click="ExportProgress_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Margin="0,4,0,10"
                                   Text="This student's practice, day by day. Kept with their settings; not copied when settings are exported."/>
                        <Grid x:Name="ProgressTable"/>
                        <TextBlock x:Name="ProgressStatus" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Scroll" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Text="Point at the list and push the right stick"/>
                        </StackPanel>
                        <Border Background="#262626" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Visible">
                                <StackPanel x:Name="TryScrollList" Margin="12,6"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Controller ============================ -->
        <!-- Saved for this student as soon as a setting is changed -->
        <ScrollViewer x:Name="ControllerPage" Grid.Row="2" Margin="16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <!-- Buttons: the Guide's drawing again, where clicking a label chooses
                     that button's job for this student -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                                <TextBlock Text="Buttons" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Style="{StaticResource SettingHint}" FontSize="14"
                                           Text="Click a label, or a button on the drawing, to choose what it does for this student. These are the jobs while the keyboard is closed; while it is open, A, B, Y, LB, RB and the D-pad type."/>
                            </StackPanel>
                            <Button Style="{StaticResource ToggleButtonStyle}" Width="180" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="Back to standard" Click="ButtonsStandard_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="540"/>
                            </Grid.ColumnDefinitions>
                            <views:ControllerDrawing x:Name="JobsDrawing" Grid.Column="0" MaxHeight="520" VerticalAlignment="Top"/>
                            <Border Grid.Column="2" Background="#262626" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="JobChooserTitle" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock x:Name="JobChooserHint" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,2,0,0"/>
                                    <!-- The D-pad and the stick presses are more than one button: which one -->
                                    <WrapPanel x:Name="JobParts" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="JobLockedText" Foreground="{StaticResource WarningBrush}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <WrapPanel x:Name="JobChoices" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Pointer" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Pointer speed" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Left stick. Slower is easier to control" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="CursorSlower_Click"/>
                                        <TextBlock x:Name="CursorSpeedValue" Style="{StaticResource ValueText}"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="CursorFaster_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Scroll speed" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Right stick" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="ScrollSlower_Click"/>
                                        <TextBlock x:Name="ScrollSpeedValue" Style="{StaticResource ValueText}"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="ScrollFaster_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Click by resting" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Clicks when the pointer stops, instead of A" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DwellClickToggle" Style="{StaticResource ToggleButtonStyle}" Click="DwellClickToggle_Click"/>
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="DwellClickShorter_Click" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="DwellClickValue" Style="{StaticResource ValueText}"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="DwellClickLonger_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Pointer feel" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Gentle: slower for a small push, faster for a big one" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="CurveSteadyButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Steady" Click="CurveSteady_Click"/>
                                        <Button x:Name="CurveGentleButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Gentle" Click="CurveGentle_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Smooth out wobbles" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Steadies a shaky stick. More lags a little behind" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="SmoothingLess_Click"/>
                                        <TextBlock x:Name="SmoothingValue" Style="{StaticResource ValueText}" Width="96"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="SmoothingMore_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Ignore quick repeat presses" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="A press this soon after letting go is ignored" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="RepeatShorter_Click"/>
                                        <TextBlock x:Name="IgnoreRepeatValue" Style="{StaticResource ValueText}" Width="96"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="RepeatLonger_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Slow pointer speed" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="A share of the normal speed, while Slow pointer is on" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BigButton}" Content="−" Click="SlowPointerSlower_Click"/>
                                        <TextBlock x:Name="SlowPointerValue" Style="{StaticResource ValueText}"/>
                                        <Button Style="{StaticResource BigButton}" Content="+" Click="SlowPointerFaster_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Other programs" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Pause while Grid 3 is open" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="So the two do not fight over the pointer" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <Button x:Name="Grid3Toggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="Grid3Toggle_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="This student's settings" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="Changes are saved for this student straight away." Style="{StaticResource SettingHint}" FontSize="14"/>
                                <TextBlock x:Name="SettingsLocationText" Style="{StaticResource SettingHint}" Margin="0,2,0,10"/>
                                <TextBlock Text="To give another student the same settings, export them here, then import them while logged in as that student." Style="{StaticResource SettingHint}" FontSize="14" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToggleButtonStyle}" Width="190" Content="Export settings..." Click="ExportSettings_Click"/>
                                    <Button Style="{StaticResource ToggleButtonStyle}" Width="190" Content="Import settings..." Click="ImportSettings_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ExportImportStatus" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================= Keyboard ============================= -->
        <ScrollViewer x:Name="KeyboardPage" Grid.Row="2" Margin="16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Keyboard" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="KeyboardButtonHint" Style="{StaticResource SettingHint}" FontSize="14" VerticalAlignment="Center" Margin="12,2,0,0"/>
                            </StackPanel>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Size" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Bigger keys and text" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardSmaller_Click"/>
                                    <TextBlock x:Name="KeyboardSizeValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardBigger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Where it opens" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="LT moves it while it is open" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardTopButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Top" Click="KeyboardTop_Click"/>
                                    <Button x:Name="KeyboardBottomButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Bottom" Click="KeyboardBottom_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Type by resting" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Types the key the orange box rests on" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardDwellToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardDwellToggle_Click"/>
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardDwellShorter_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="KeyboardDwellValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardDwellLonger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Fade when resting" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="See the text behind it" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardFadeToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardFadeToggle_Click"/>
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeShorter_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="KeyboardFadeValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeLonger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Faded keyboard shows" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="How much stays visible" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeFainter_Click"/>
                                    <TextBlock x:Name="KeyboardFadeOpacityValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeStronger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Capitals automatically" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Starts sentences, and I, with a capital" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="AutoCapitalToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="AutoCapitalToggle_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Shortcut keys" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="The Edit, Select, Style and Tools rows" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="ShortcutsToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="ShortcutsToggle_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- The Apps key: which programs it offers this student -->
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Apps key" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ToggleButtonStyle}" Width="180" FontSize="16" HorizontalAlignment="Right"
                                        Content="Back to standard" Click="AppsStandard_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Margin="0,4,0,10"
                                       Text="The programs the keyboard's Apps key opens in one press. Click one to change it. Only programs installed on this PC are offered."/>
                            <UniformGrid x:Name="AppEditor" Columns="3"/>
                            <Border x:Name="AppChooser" Visibility="Collapsed" Background="#262626" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Choose a program for this place" Style="{StaticResource SettingTitle}"/>
                                    <WrapPanel x:Name="AppChoices" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <!-- Shortcut keys: this student's own set, from a fixed list of safe keys.
                         Built by the code from the catalogue. -->
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Shortcut keys" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource ToggleButtonStyle}" Width="180" FontSize="16" HorizontalAlignment="Right"
                                        Content="Back to standard" Click="ShortcutsStandard_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Margin="0,4,0,10"
                                       Text="Click a key to change it, or to leave its place empty. Each row keeps to its own kind of key. The keyboard's bottom row follows the program in front and is not changed here."/>
                            <StackPanel x:Name="ShortcutEditor"/>
                            <Border x:Name="ShortcutChooser" Visibility="Collapsed" Background="#262626" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ShortcutChooserTitle" Style="{StaticResource SettingTitle}"/>
                                    <WrapPanel x:Name="ShortcutChoices" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Phrases" Style="{StaticResource PanelTitle}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Margin="0,0,0,10"
                                       Text="Typed whole from the Phrases key on the keyboard - a name, an email address, a sentence used often. Type them here with a normal keyboard."/>
                            <UniformGrid Columns="2">
                                <TextBox x:Name="Phrase0" Style="{StaticResource PhraseBox}" Tag="0"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase1" Style="{StaticResource PhraseBox}" Tag="1"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase2" Style="{StaticResource PhraseBox}" Tag="2"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase3" Style="{StaticResource PhraseBox}" Tag="3"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase4" Style="{StaticResource PhraseBox}" Tag="4"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase5" Style="{StaticResource PhraseBox}" Tag="5"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows keyboard" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Block the Windows keyboard" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="It pops up and takes over the controller" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="StopWindowsKeyboardToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="StopWindowsKeyboardToggle_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
