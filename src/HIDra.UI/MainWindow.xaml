<Window x:Class="HIDra.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HIDra.UI"
        mc:Ignorable="d"
        Title="HIDra - Controller to Mouse/Keyboard"
        Height="900" Width="1600"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1B1B1B">

    <!--
        Two pages, split by who they are for:

          Guide     for the student, and what opens: a controller drawing labelled with
                    what every button does - using the pointer, or typing - with each
                    button lighting up orange as it is pressed, and "How do I..." beside
                    it for everyday tasks.
          Settings  for staff, set once and rarely touched: every setting, in groups.

        Both on one page was too much at once: every label on the drawing carried
        controls the student never needs, and the settings were scattered across it.
        Whether the controller is connected, and Pause, stay in the bar above both.

        Everything is aimed at with the pointer the controller drives, so every control
        is large, well spaced, and shows the pointer is over it with a thick orange
        border. It opens maximised.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A"/>

        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentOnBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off and choice buttons: the code paints them orange when selected -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- The two pages. Orange for the one showing, like any other choice here. -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="70"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="MinHeight" Value="50"/>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PhraseBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- A label on the controller drawing. The code turns its border orange while
             its button is pressed. -->
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="58"/>
        </Style>
        <Style x:Key="CardAction" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LeaderLine" TargetType="Line">
            <Setter Property="Stroke" Value="#6B7278"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- A controller button drawn as it looks on the controller, for labels and for
             the "How do I..." text. Face buttons keep Xbox colours, because they match
             the controller in the student's hands. -->
        <Style x:Key="Badge" TargetType="ContentControl">
            <Setter Property="Background" Value="#50575E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="1,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                MinWidth="24" Height="24" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BadgeA" TargetType="ContentControl" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Content" Value="A"/>
        </Style>
        <Style x:Key="BadgeB" TargetType="ContentControl" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#E5484D"/>
            <Setter Property="Content" Value="B"/>
        </Style>
        <Style x:Key="BadgeX" TargetType="ContentControl" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Content" Value="X"/>
        </Style>
        <Style x:Key="BadgeY" TargetType="ContentControl" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#F2C12E"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Content" Value="Y"/>
        </Style>

        <Style x:Key="HowToCard" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HowToTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="HowToText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#D0D4D8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="27"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status bar: is it working, and the one button that stops it. Above both
             pages, so it is always in view. -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Image Source="HIDra.ico" Width="36" Height="36" Margin="0,0,10,0"/>
                    <TextBlock Text="HIDra" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="#DC3545" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#DC3545" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ControllerInfo" Text="No controller detected" FontSize="14"
                               Foreground="#CCCCCC" TextWrapping="Wrap"/>
                    <!-- Battery state, so staff can see at the start of a session whether the
                         controller will last, and so a low battery is visible before it fails. -->
                    <TextBlock x:Name="BatteryText" Text="" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CCCCCC" Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource BigButton}"
                        Content="Pause" Width="120" FontSize="18" IsEnabled="False"
                        Margin="20,0,0,0" Click="StopButton_Click"/>
            </Grid>
        </Border>

        <!-- The two pages -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,14,16,0">
            <Button x:Name="GuideTabButton" Style="{StaticResource TabButton}" Content="Guide" Click="GuideTab_Click"/>
            <Button x:Name="SettingsTabButton" Style="{StaticResource TabButton}" Content="Settings" Click="SettingsTab_Click"/>
        </StackPanel>

        <!-- ============================== Guide ============================== -->
        <Grid x:Name="GuidePage" Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- What every button does -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="What each button does" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Press a button on the controller to see it light up" Style="{StaticResource SettingHint}" FontSize="14"/>
                        </StackPanel>
                        <!-- Follows the keyboard: typing while it is open, the pointer while
                             it is closed. Staff can flip it to look ahead. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ModePointerButton" Style="{StaticResource ToggleButtonStyle}" Width="170" FontSize="16"
                                    Content="Using the pointer" Click="ModePointer_Click"/>
                            <Button x:Name="ModeTypingButton" Style="{StaticResource ToggleButtonStyle}" Width="120" FontSize="16"
                                    Content="Typing" Click="ModeTyping_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- The Viewbox scales the drawing to the space available, so it stays
                         whole on a small laptop screen -->
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas Width="1000" Height="510">

                            <!-- The controller. Drawn first so the labels' lines run over it. -->
                            <Canvas Canvas.Left="330" Canvas.Top="150">
                                <Rectangle x:Name="CtlLT" Canvas.Left="45" Canvas.Top="-44" Width="80" Height="20" RadiusX="9" RadiusY="9" Fill="#50575E" Stroke="#6B7278" StrokeThickness="2"/>
                                <Rectangle x:Name="CtlRT" Canvas.Left="215" Canvas.Top="-44" Width="80" Height="20" RadiusX="9" RadiusY="9" Fill="#50575E" Stroke="#6B7278" StrokeThickness="2"/>
                                <Rectangle x:Name="CtlLB" Canvas.Left="38" Canvas.Top="-18" Width="94" Height="16" RadiusX="8" RadiusY="8" Fill="#50575E" Stroke="#6B7278" StrokeThickness="2"/>
                                <Rectangle x:Name="CtlRB" Canvas.Left="208" Canvas.Top="-18" Width="94" Height="16" RadiusX="8" RadiusY="8" Fill="#50575E" Stroke="#6B7278" StrokeThickness="2"/>
                                <TextBlock Canvas.Left="76" Canvas.Top="-42" Text="LT" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Canvas.Left="246" Canvas.Top="-42" Text="RT" FontSize="12" FontWeight="Bold" Foreground="White"/>

                                <Path Fill="#33373B" Stroke="#6B7278" StrokeThickness="2"
                                      Data="M 70,20 C 110,6 230,6 270,20 C 312,32 332,72 338,140 C 344,205 334,246 300,249 C 276,251 262,228 246,203 C 236,190 104,190 94,203 C 78,228 64,251 40,249 C 6,246 -4,205 2,140 C 8,72 28,32 70,20 Z"/>

                                <Ellipse x:Name="CtlLeftStick" Canvas.Left="57" Canvas.Top="57" Width="56" Height="56" Fill="#222426" Stroke="#8A9096" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="68" Canvas.Top="68" Width="34" Height="34" Fill="#34383C" IsHitTestVisible="False"/>
                                <Ellipse x:Name="CtlRightStick" Canvas.Left="189" Canvas.Top="124" Width="52" Height="52" Fill="#222426" Stroke="#8A9096" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="199" Canvas.Top="134" Width="32" Height="32" Fill="#34383C" IsHitTestVisible="False"/>
                                <Path x:Name="CtlDPad" Fill="#222426" Stroke="#8A9096" StrokeThickness="2"
                                      Data="M 118,128 H 132 V 143 H 147 V 157 H 132 V 172 H 118 V 157 H 103 V 143 H 118 Z"/>

                                <Rectangle x:Name="CtlBack" Canvas.Left="130" Canvas.Top="82" Width="20" Height="13" RadiusX="5" RadiusY="5" Fill="#50575E" Stroke="#9AA0A6" StrokeThickness="1.5"/>
                                <Rectangle x:Name="CtlStart" Canvas.Left="190" Canvas.Top="82" Width="20" Height="13" RadiusX="5" RadiusY="5" Fill="#50575E" Stroke="#9AA0A6" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="157" Canvas.Top="42" Width="26" Height="26" Fill="#50575E" Stroke="#9AA0A6"/>

                                <Ellipse x:Name="CtlY" Canvas.Left="250" Canvas.Top="50" Width="24" Height="24" Fill="#F2C12E" Stroke="Transparent" StrokeThickness="3"/>
                                <TextBlock Canvas.Left="250" Canvas.Top="53" Width="24" TextAlignment="Center" Text="Y" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A"/>
                                <Ellipse x:Name="CtlX" Canvas.Left="226" Canvas.Top="76" Width="24" Height="24" Fill="#3B82F6" Stroke="Transparent" StrokeThickness="3"/>
                                <TextBlock Canvas.Left="226" Canvas.Top="79" Width="24" TextAlignment="Center" Text="X" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <Ellipse x:Name="CtlB" Canvas.Left="274" Canvas.Top="76" Width="24" Height="24" Fill="#E5484D" Stroke="Transparent" StrokeThickness="3"/>
                                <TextBlock Canvas.Left="274" Canvas.Top="79" Width="24" TextAlignment="Center" Text="B" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <Ellipse x:Name="CtlA" Canvas.Left="250" Canvas.Top="102" Width="24" Height="24" Fill="#4CAF50" Stroke="Transparent" StrokeThickness="3"/>
                                <TextBlock Canvas.Left="250" Canvas.Top="105" Width="24" TextAlignment="Center" Text="A" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </Canvas>

                            <!-- Lines from each label to its control. The face buttons have none:
                                 their labels carry the button's own colour, and a line to any
                                 of the four had to cross the others. -->
                            <Line Style="{StaticResource LeaderLine}" X1="300" Y1="39" X2="378" Y2="116"/>
                            <Line Style="{StaticResource LeaderLine}" X1="300" Y1="105" X2="370" Y2="140"/>
                            <Line Style="{StaticResource LeaderLine}" X1="300" Y1="235" X2="387" Y2="235"/>
                            <Line Style="{StaticResource LeaderLine}" X1="300" Y1="319" X2="433" Y2="300"/>
                            <Line Style="{StaticResource LeaderLine}" X1="700" Y1="39" X2="622" Y2="116"/>
                            <Line Style="{StaticResource LeaderLine}" X1="700" Y1="105" X2="630" Y2="140"/>
                            <Line Style="{StaticResource LeaderLine}" X1="700" Y1="435" X2="562" Y2="318"/>
                            <Line Style="{StaticResource LeaderLine}" X1="478" Y1="68" X2="470" Y2="228"/>
                            <Line Style="{StaticResource LeaderLine}" X1="522" Y1="68" X2="530" Y2="228"/>

                            <!-- Left side -->
                            <Border x:Name="CardLT" Style="{StaticResource GuideCard}" Canvas.Left="0" Canvas.Top="10">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="LT"/>
                                    <TextBlock x:Name="ActLT" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardLB" Style="{StaticResource GuideCard}" Canvas.Left="0" Canvas.Top="76">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="LB"/>
                                    <TextBlock x:Name="ActLB" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardLeftStick" Style="{StaticResource GuideCard}" Canvas.Left="0" Canvas.Top="206">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="Left stick"/>
                                    <TextBlock x:Name="ActLeftStick" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardDPad" Style="{StaticResource GuideCard}" Canvas.Left="0" Canvas.Top="290">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="D-pad"/>
                                    <TextBlock x:Name="ActDPad" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardStickPress" Style="{StaticResource GuideCard}" Canvas.Left="0" Canvas.Top="372">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="Press a stick in"/>
                                    <TextBlock Text="Undo" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>

                            <!-- Top centre -->
                            <Border x:Name="CardBack" Style="{StaticResource GuideCard}" Canvas.Left="330" Canvas.Top="10" Width="165">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="Back"/>
                                    <TextBlock Text="Start menu" Style="{StaticResource CardAction}" FontSize="16"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardStart" Style="{StaticResource GuideCard}" Canvas.Left="505" Canvas.Top="10" Width="165">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="Start"/>
                                    <TextBlock Text="All windows" Style="{StaticResource CardAction}" FontSize="16"/>
                                </DockPanel>
                            </Border>

                            <!-- Bottom centre: the way back, whatever else has happened -->
                            <Border x:Name="CardRecovery" Style="{StaticResource GuideCard}" Canvas.Left="330" Canvas.Top="420" Width="340" Height="80" Padding="10,6">
                                <TextBlock Style="{StaticResource CardAction}" FontSize="15.5" LineHeight="28">
                                    <Run Text="HIDra window gone? Hold"/>
                                    <InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="Back"/></InlineUIContainer><Run Text="and"/>
                                    <InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="Start"/></InlineUIContainer><Run Text="together for one second."/>
                                </TextBlock>
                            </Border>

                            <!-- Right side -->
                            <Border x:Name="CardRT" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="10">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="RT"/>
                                    <TextBlock x:Name="ActRT" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardRB" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="76">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="RB"/>
                                    <TextBlock x:Name="ActRB" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardY" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="142">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource BadgeY}"/>
                                    <TextBlock x:Name="ActY" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardB" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="208">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource BadgeB}"/>
                                    <TextBlock x:Name="ActB" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardX" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="274">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource BadgeX}"/>
                                    <TextBlock x:Name="ActX" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardA" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="340">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource BadgeA}"/>
                                    <TextBlock x:Name="ActA" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="CardRightStick" Style="{StaticResource GuideCard}" Canvas.Left="700" Canvas.Top="406">
                                <DockPanel VerticalAlignment="Center">
                                    <ContentControl Style="{StaticResource Badge}" Content="Right stick"/>
                                    <TextBlock x:Name="ActRightStick" Style="{StaticResource CardAction}"/>
                                </DockPanel>
                            </Border>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- How do I... The everyday questions, a line or two each, with the buttons
                 drawn as they look on the controller -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14,12,14,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="How do I..." Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="HowToModeText" Style="{StaticResource SettingHint}" FontSize="14"/>
                    </StackPanel>
                    <!-- One set of cards for each side of the switch, so only what can be
                         done right now is shown -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="HowToPointer">
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Click on something" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Move the pointer with the left stick."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="clicks, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeB}"/></InlineUIContainer><Run Text="right-clicks, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="RB"/></InlineUIContainer><Run Text="double-clicks. Hold "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="RT"/></InlineUIContainer><Run Text="to drag."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Scroll a page" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Push the right stick the way you want to go."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeY}"/></InlineUIContainer><Run Text="swaps the sticks, if the other hand is easier."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Arrange windows" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="D-pad up makes a window full screen, down hides it."/><LineBreak/><Run Text="Left or right puts it on that half of the screen."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Switch programs" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LB"/></InlineUIContainer><Run Text="shows them; press it again to move along. "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="picks one, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeB}"/></InlineUIContainer><Run Text="goes back."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeX}"/></InlineUIContainer><Run Text="for the keyboard, then go to Apps at the top left. "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="on a program opens it."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Start typing" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Click where the words should go, then press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeX}"/></InlineUIContainer><Run Text="for the keyboard."/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="HowToTyping" Visibility="Collapsed">
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Steer the orange box with the left stick."/><LineBreak/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="types the key, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeB}"/></InlineUIContainer><Run Text="types a capital or the symbol on top."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type faster" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LB"/></InlineUIContainer><Run Text="deletes, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="RB"/></InlineUIContainer><Run Text="space, "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeY}"/></InlineUIContainer><Run Text="Enter."/><LineBreak/><Run Text="Push up from the top row to pick a green word."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type numbers and symbols" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go to 123 #+ at the bottom left and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><LineBreak/><Run Text="abc, in the same place, brings the letters back."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Type a saved phrase" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go up to Phrases, at the start of the green row, and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="- then pick the phrase. Staff set them on the Settings tab."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Copy and paste" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Select, then move to highlight the text, then Copy. Go to where it belongs, then Paste."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Keyboard in the way?" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Badge}" Content="LT"/></InlineUIContainer><Run Text="moves it to the top or bottom of the screen. "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeX}"/></InlineUIContainer><Run Text="closes it."/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource HowToCard}">
                                    <StackPanel>
                                        <TextBlock Text="Open a program" Style="{StaticResource HowToTitle}"/>
                                        <TextBlock Style="{StaticResource HowToText}"><Run Text="Go to Apps at the top left and press "/><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeA}"/></InlineUIContainer><Run Text="on the program."/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================= Settings ============================= -->
        <!-- Saved for this student as soon as a setting is changed. Each says which
             button it goes with, so the link to the Guide is not lost. -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Margin="16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Pointer" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Pointer speed" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Left stick. Slower is easier to control" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="CursorSlower_Click"/>
                                    <TextBlock x:Name="CursorSpeedValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="CursorFaster_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Scroll speed" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Right stick" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="ScrollSlower_Click"/>
                                    <TextBlock x:Name="ScrollSpeedValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="ScrollFaster_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Click by resting" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Clicks when the pointer stops, instead of A" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DwellClickToggle" Style="{StaticResource ToggleButtonStyle}" Click="DwellClickToggle_Click"/>
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="DwellClickShorter_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="DwellClickValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="DwellClickLonger_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Keyboard" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SettingHint}" FontSize="14" VerticalAlignment="Center" Margin="12,2,0,0">
                                    <InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource BadgeX}"/></InlineUIContainer><Run Text="opens and closes it"/>
                                </TextBlock>
                            </StackPanel>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Size" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Bigger keys and text" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardSmaller_Click"/>
                                    <TextBlock x:Name="KeyboardSizeValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardBigger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Where it opens" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="LT moves it while it is open" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardTopButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Top" Click="KeyboardTop_Click"/>
                                    <Button x:Name="KeyboardBottomButton" Style="{StaticResource ToggleButtonStyle}" Width="100" Content="Bottom" Click="KeyboardBottom_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Type by resting" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Types the key the orange box rests on" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardDwellToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardDwellToggle_Click"/>
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardDwellShorter_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="KeyboardDwellValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardDwellLonger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Fade when resting" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="See the text behind it" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="KeyboardFadeToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardFadeToggle_Click"/>
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeShorter_Click" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="KeyboardFadeValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeLonger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Faded keyboard shows" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="How much stays visible" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeFainter_Click"/>
                                    <TextBlock x:Name="KeyboardFadeOpacityValue" Style="{StaticResource ValueText}"/>
                                    <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeStronger_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Capitals automatically" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Starts sentences, and I, with a capital" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="AutoCapitalToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="AutoCapitalToggle_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Shortcut keys" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="The Edit, Select, Style and Tools rows" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="ShortcutsToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="ShortcutsToggle_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Phrases" Style="{StaticResource PanelTitle}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="14" Margin="0,0,0,10"
                                       Text="Typed whole from the Phrases key on the keyboard - a name, an email address, a sentence used often. Type them here with a normal keyboard."/>
                            <UniformGrid Columns="2">
                                <TextBox x:Name="Phrase0" Style="{StaticResource PhraseBox}" Tag="0"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase1" Style="{StaticResource PhraseBox}" Tag="1"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase2" Style="{StaticResource PhraseBox}" Tag="2"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase3" Style="{StaticResource PhraseBox}" Tag="3"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase4" Style="{StaticResource PhraseBox}" Tag="4"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                                <TextBox x:Name="Phrase5" Style="{StaticResource PhraseBox}" Tag="5"
                                         TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Block the Windows keyboard" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="It pops up and takes over the controller" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="StopWindowsKeyboardToggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="StopWindowsKeyboardToggle_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Pause while Grid 3 is open" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="So the two do not fight over the pointer" Style="{StaticResource SettingHint}"/>
                                </StackPanel>
                                <Button x:Name="Grid3Toggle" Grid.Column="1" Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center" Click="Grid3Toggle_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Changes are saved for this student straight away."
                               FontSize="14" Foreground="#999999" Margin="4,0,0,0"/>
                    <TextBlock x:Name="SettingsLocationText" FontSize="13" Foreground="#888888"
                               TextWrapping="Wrap" Margin="4,2,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
