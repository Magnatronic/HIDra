                      <Line X1="332" Y1="62" X2="324" Y2="195" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="321" Canvas.Top="192" Width="6" Height="6" Fill="#8A9096"/>
                      <TextBlock Canvas.Left="170" Canvas.Top="-1" Width="170" TextAlignment="Right" TextWrapping="Wrap" LineHeight="20"><Run Text="Back" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Start menu" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <Line X1="368" Y1="62" X2="376" Y2="195" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="373" Canvas.Top="192" Width="6" Height="6" Fill="#8A9096"/>
                      <TextBlock Canvas.Left="360" Canvas.Top="-1" Width="170" TextAlignment="Left" TextWrapping="Wrap" LineHeight="20"><Run Text="Start" FontWeight="Bold" Foreground="White" FontSize="16"/><LineBreak/><Run Text="Task View" Foreground="#D0D4D8" FontSize="14"/></TextBlock>
                      <TextBlock Canvas.Left="0" Canvas.Top="412" Width="730" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="#D0D4D8" LineHeight="21"><Run Text="Keyboard open:" FontWeight="Bold" Foreground="White"/><Run Text=" left stick moves the highlight · A types · B types capitals and symbols · push up for word suggestions"/><LineBreak/><Run Text="Window gone?" FontWeight="Bold" Foreground="White"/><Run Text=" Hold Back and Start together for one second."/></TextBlock>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- Every setting, saved for this student as soon as it is changed -->
            <Border Grid.Column="1" Background="#262626" CornerRadius="10" Padding="18,2,18,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CURSOR AND SCROLLING" Style="{StaticResource SectionTitle}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Cursor speed" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Slower is easier to control" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BigButton}" Content="−" Click="CursorSlower_Click"/>
                        <TextBlock x:Name="CursorSpeedValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="CursorFaster_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Scroll speed" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="How fast the right stick scrolls" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BigButton}" Content="−" Click="ScrollSlower_Click"/>
                        <TextBlock x:Name="ScrollSpeedValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="ScrollFaster_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Click by resting" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Clicks when the cursor stops" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DwellClickToggle" Style="{StaticResource ToggleButtonStyle}" Click="DwellClickToggle_Click"/>
                        <Button Style="{StaticResource BigButton}" Content="−" Click="DwellClickShorter_Click" Margin="10,0,0,0"/>
                        <TextBlock x:Name="DwellClickValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="DwellClickLonger_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="KEYBOARD" Style="{StaticResource SectionTitle}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Type by resting" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Types the key the highlight rests on" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="KeyboardDwellToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardDwellToggle_Click"/>
                        <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardDwellShorter_Click" Margin="10,0,0,0"/>
                        <TextBlock x:Name="KeyboardDwellValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardDwellLonger_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Fade when resting" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Lets the text behind show through" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="KeyboardFadeToggle" Style="{StaticResource ToggleButtonStyle}" Click="KeyboardFadeToggle_Click"/>
                        <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeShorter_Click" Margin="10,0,0,0"/>
                        <TextBlock x:Name="KeyboardFadeValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeLonger_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Faded keyboard shows" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="How much stays visible when faded" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardFadeFainter_Click"/>
                        <TextBlock x:Name="KeyboardFadeOpacityValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardFadeStronger_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Keyboard size" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Bigger keys and text" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BigButton}" Content="−" Click="KeyboardSmaller_Click"/>
                        <TextBlock x:Name="KeyboardSizeValue" Style="{StaticResource ValueText}"/>
                        <Button Style="{StaticResource BigButton}" Content="+" Click="KeyboardBigger_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Shortcut keys" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="The blue panel beside the keyboard" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShortcutsToggle" Style="{StaticResource ToggleButtonStyle}" Click="ShortcutsToggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Capitals automatically" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Starts sentences, and I, with a capital" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AutoCapitalToggle" Style="{StaticResource ToggleButtonStyle}" Click="AutoCapitalToggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Keyboard position" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="LT on the controller also moves it" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="KeyboardTopButton" Style="{StaticResource ToggleButtonStyle}" Content="Top" Click="KeyboardTop_Click"/>
                        <Button x:Name="KeyboardBottomButton" Style="{StaticResource ToggleButtonStyle}" Content="Bottom" Click="KeyboardBottom_Click" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="PHRASES" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,6"
                                   Text="Typed whole from the Phrases key on the keyboard. Type them here with a normal keyboard."/>
                        <UniformGrid Columns="2">
                            <TextBox x:Name="Phrase0" Style="{StaticResource PhraseBox}" Tag="0"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            <TextBox x:Name="Phrase1" Style="{StaticResource PhraseBox}" Tag="1"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            <TextBox x:Name="Phrase2" Style="{StaticResource PhraseBox}" Tag="2"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            <TextBox x:Name="Phrase3" Style="{StaticResource PhraseBox}" Tag="3"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            <TextBox x:Name="Phrase4" Style="{StaticResource PhraseBox}" Tag="4"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                            <TextBox x:Name="Phrase5" Style="{StaticResource PhraseBox}" Tag="5"
                                     TextChanged="Phrase_TextChanged" LostKeyboardFocus="Phrase_LostFocus"/>
                        </UniformGrid>
                        <TextBlock Text="WINDOWS" Style="{StaticResource SectionTitle}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Block the Windows keyboard" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="It pops up and takes over the controller" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StopWindowsKeyboardToggle" Style="{StaticResource ToggleButtonStyle}" Click="StopWindowsKeyboardToggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Pause while Grid 3 is open" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="So the two do not fight over the pointer" Style="{StaticResource SettingHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="Grid3Toggle" Style="{StaticResource ToggleButtonStyle}" Click="Grid3Toggle_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Changes are saved for this student straight away."
                                   FontSize="13" Foreground="#888888" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SettingsLocationText" FontSize="12" Foreground="#777777"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
