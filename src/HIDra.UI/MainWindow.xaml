                      <TextBlock Canvas.Left="525" Canvas.Top="211" Width="205" TextAlignment="Left"><InlineUIContainer BaselineAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#4CAF50" Margin="0,0,6,0"><TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer><Run Text="Click" Foreground="#D0D4D8" FontSize="15"/></TextBlock>
                      <TextBlock Canvas.Left="525" Canvas.Top="243" Width="205" TextAlignment="Left"><InlineUIContainer BaselineAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#E5484D" Margin="0,0,6,0"><TextBlock Text="B" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer><Run Text="Right click" Foreground="#D0D4D8" FontSize="15"/></TextBlock>
                      <TextBlock Canvas.Left="525" Canvas.Top="275" Width="205" TextAlignment="Left"><InlineUIContainer BaselineAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#3B82F6" Margin="0,0,6,0"><TextBlock Text="X" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer><Run Text="Open / close keyboard" Foreground="#D0D4D8" FontSize="15"/></TextBlock>
                      <Line X1="520" Y1="350" X2="424" Y2="270" Stroke="#8A9096" StrokeThickness="1.5"/>
                      <Ellipse Canvas.Left="421" Canvas.Top="267" Width="6" Height="6" Fill="#8A9096"/>
