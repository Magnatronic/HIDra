<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HIDra.Core\HIDra.Core.csproj" />
    <ProjectReference Include="..\HIDra.Models\HIDra.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Reaching Windows.Gaming.Input needs the SDK moniker above, but the app
         itself still runs on older Windows 10: the diagnostic is guarded and the
         API has existed since 1709. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- For the notification-area icon (System.Windows.Forms.NotifyIcon), which is
         how the window is recovered once it has been hidden. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- HIDra branding -->
    <AssemblyName>HIDra.UI</AssemblyName>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>HIDra - Controller Accessibility Tool</Product>
    <Company>Magnatronic</Company>
    <Copyright>MIT License</Copyright>
    <Description>Control Windows with an Xbox controller for accessibility</Description>
    <!-- Used for the exe, the window title bars and taskbar, and the notification area -->
    <ApplicationIcon>HIDra.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded, so the notification area can load it at its own small size
         rather than shrinking the 32px copy Windows extracts from the exe. -->
    <Resource Include="HIDra.ico" />
    <Resource Include="HIDra-logo.png" />
  </ItemGroup>

  <!-- Conditional publishing settings for self-contained builds -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
